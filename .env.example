# Copy to .env and change values. NEVER commit .env
# PPE_DATABASE_URL=sqlite:///C:/path/to/server.db   (default: <project>/data/server.db)
PPE_EDGE_API_KEY=change-me-to-a-long-random-string
PPE_EVIDENCE_RETENTION_DAYS=30
PPE_SQL_ECHO=false
# Inference device for the backend:
#   auto (default) = use the GPU only if it has >= 1500 MB free VRAM, otherwise the CPU
#   cpu            = never touch the GPU
#   0              = force the first GPU
PPE_DETECT_DEVICE=auto
