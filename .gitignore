# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Secrets
.env

# Data, models, outputs (too big / private for GitHub)
datasets/*
!datasets/README.md
data/
runs/
models/*.pt
*.pt
*.onnx
*.engine
evidence/
*.db
*.db-wal
*.db-shm

# Recorded videos (may contain people)
*.mp4
*.avi
*.mov

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Colab transfer bundle (large)
colab_bundle.zip

# Copilot outbox (local alert queue, not committed)
data/outbox.jsonl

# Sign-in accounts (password hashes) - per machine, never source
configs/users.yaml

# Generated operational data - recordings, snapshots, logs, reports.
# data/ is already ignored above; these are named explicitly so nobody is tempted
# to commit a clip of a worker by adding an exception.
data/recordings/
data/snapshots/
data/logs/
data/reports/
data/evidence/
*.mp4
!samples/demo_clip.mp4
